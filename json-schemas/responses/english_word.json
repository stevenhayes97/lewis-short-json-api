{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stevenhayes97.github.io/lewis-short-json-api/json-schemas/responses/english_word.json",
  "title": "EnglishWordTranslationResponse",
  "description": "Latin → English word response. results is always an array (empty if no matches).",
  "type": "object",
  "additionalProperties": false,
  "required": ["translation_type", "latin_word", "definition_mode", "results"],
  "properties": {
    "translation_type": {
      "const": "english_word"
    },
    "latin_word": {
      "type": "string",
      "minLength": 1,
      "description": "Echo of the requested Latin word."
    },
    "definition_mode": {
      "$ref": "../common/definition_mode.json#/$defs/definition_mode",
      "description": "Effective mode used to build results (defaults to full when omitted on the request)."
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/english_word_result"
      }
    }
  },
  "$defs": {
    "english_word_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["english_word", "part_of_speech", "summary", "definitions"],
      "properties": {
        "english_word": {
          "type": "string",
          "minLength": 1,
          "description": "Primary English gloss (often the first sense)."
        },
        "part_of_speech": {
          "type": "string",
          "minLength": 1,
          "description": "Lowercase part of speech label, e.g. noun, verb, adjective."
        },
        "summary": {
          "type": "string",
          "description": "Optional learning blurb. Empty string until filled (often by an agent later)."
        },
        "definitions": {
          "type": "array",
          "description": "Lewis & Short sense material for this headword. Length is capped in simplified mode.",
          "items": {
            "$ref": "#/$defs/sense_node"
          }
        }
      }
    },
    "sense_node": {
      "description": "One sense line or a nested group of sub-senses, matching the dictionary JSON shape.",
      "oneOf": [
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/sense_node" }
        }
      ]
    }
  },
  "examples": [
    {
      "translation_type": "english_word",
      "latin_word": "canis",
      "definition_mode": "full",
      "results": [
        {
          "english_word": "dog",
          "part_of_speech": "noun",
          "summary": "",
          "definitions": ["A dog; a hound."]
        }
      ]
    },
    {
      "translation_type": "english_word",
      "latin_word": "amo",
      "definition_mode": "simplified",
      "results": [
        {
          "english_word": "love",
          "part_of_speech": "verb",
          "summary": "",
          "definitions": [
            "to like, to love …",
            "In gen.: …",
            "Esp."
          ]
        }
      ]
    }
  ]
}
