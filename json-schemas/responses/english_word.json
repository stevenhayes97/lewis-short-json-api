{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stevenhayes97.github.io/lewis-short-json-api/json-schemas/responses/english_word.json",
  "title": "EnglishWordTranslationResponse",
  "description": "Latin → English word response. Combines a Logeion-style brief gloss list with optional full Lewis & Short senses, plus Scriba-style morphology and connections tabs per hit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["translation_type", "latin_word", "definition_mode", "results"],
  "properties": {
    "translation_type": {
      "const": "english_word"
    },
    "latin_word": {
      "type": "string",
      "minLength": 1,
      "description": "Echo of the requested Latin word."
    },
    "definition_mode": {
      "$ref": "../common/definition_mode.json#/$defs/definition_mode",
      "description": "Effective mode used to build results (defaults to both when omitted on the request)."
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/english_word_result"
      }
    }
  },
  "$defs": {
    "english_word_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "english_word",
        "part_of_speech",
        "summary",
        "brief_glosses",
        "definitions",
        "morphology",
        "connections"
      ],
      "properties": {
        "english_word": {
          "type": "string",
          "minLength": 1,
          "description": "Primary English gloss (typically the first brief gloss)."
        },
        "part_of_speech": {
          "type": "string",
          "minLength": 1,
          "description": "Part of speech label from Lewis & Short."
        },
        "summary": {
          "type": "string",
          "description": "Optional learning blurb. Empty string until filled (often by an agent later)."
        },
        "brief_glosses": {
          "type": "array",
          "description": "Short translation hits (Logeion-style). Empty when definition_mode is full.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "definitions": {
          "type": "array",
          "description": "Full Lewis & Short sense tree. Empty when definition_mode is brief.",
          "items": {
            "$ref": "#/$defs/sense_node"
          }
        },
        "morphology": {
          "$ref": "../common/morphology_tab.json#/$defs/morphology_tab"
        },
        "connections": {
          "$ref": "../common/connections_tab.json#/$defs/connections_tab"
        }
      }
    },
    "sense_node": {
      "description": "One sense line or a nested group of sub-senses, matching the dictionary JSON shape.",
      "oneOf": [
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/sense_node" }
        }
      ]
    }
  },
  "examples": [
    {
      "translation_type": "english_word",
      "latin_word": "canis",
      "definition_mode": "both",
      "results": [
        {
          "english_word": "dog",
          "part_of_speech": "noun",
          "summary": "",
          "brief_glosses": ["dog", "hound"],
          "definitions": ["A dog; a hound."],
          "morphology": {
            "headword": "canis",
            "title_genitive": "is",
            "gender": "M.",
            "declension": 3
          },
          "connections": {
            "entry_type": "main",
            "notes": "…"
          }
        }
      ]
    },
    {
      "translation_type": "english_word",
      "latin_word": "amo",
      "definition_mode": "full",
      "results": [
        {
          "english_word": "love",
          "part_of_speech": "v. a.",
          "summary": "",
          "brief_glosses": [],
          "definitions": ["to like, to love …"],
          "morphology": {
            "headword": "amo",
            "lemma_line": "ămo, āvi, ātum, 1, v. a. …"
          },
          "connections": {
            "entry_type": "main",
            "notes": "…"
          }
        }
      ]
    }
  ]
}
