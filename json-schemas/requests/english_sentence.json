{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stevenhayes97.github.io/lewis-short-json-api/json-schemas/requests/english_sentence.json",
  "title": "EnglishSentenceTranslationRequest",
  "description": "Latin sentence → English sentence (agent-assisted later).",
  "type": "object",
  "additionalProperties": false,
  "required": ["translation_type", "latin_sentence"],
  "properties": {
    "translation_type": {
      "const": "english_sentence"
    },
    "latin_sentence": {
      "type": "string",
      "minLength": 1,
      "description": "Latin sentence to translate."
    },
    "definition_mode": {
      "$ref": "../common/definition_mode.json#/$defs/definition_mode",
      "description": "When word-level dictionary material is included alongside the sentence translation, controls how many sense glosses are attached per headword."
    },
    "include_paradigms": {
      "$ref": "../common/include_paradigms.json#/$defs/include_paradigms"
    }
  },
  "examples": [
    {
      "translation_type": "english_sentence",
      "latin_sentence": "Canis currit."
    }
  ]
}
